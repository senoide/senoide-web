# Servidor propio de SENOIDE (Hetzner). Caddy obtiene y renueva solo los certificados HTTPS.
# Este archivo se actualiza desde GitHub cada 5 minutos (scripts/actualizar.sh).
{
	email info@senoide.es
}

(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Web pública
senoide.es {
	import seguridad
	encode zstd gzip
	# Horas libres de la agenda: se piden a la app (Cloudflare) desde el servidor
	handle /api/disponibilidad {
		reverse_proxy https://origin-app.senoide.es {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		root * /srv/senoide-web/site
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=86400"
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		respond "Página no encontrada" 404
	}
}

www.senoide.es {
	redir https://senoide.es{uri} permanent
}

# Gestión SENOIDE: puerta de entrada a la app en Cloudflare
app.senoide.es {
	import seguridad
	encode zstd gzip
	reverse_proxy https://origin-app.senoide.es {
		header_up Host {upstream_hostport}
		header_up X-Forwarded-Host app.senoide.es
	}
}
